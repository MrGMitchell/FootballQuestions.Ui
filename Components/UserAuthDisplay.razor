@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using FootballQuestions.Ui.Services
@inject HttpClient HttpClient
@inject IUserIdentityService UserIdentityService
@inject NavigationManager NavigationManager

<AuthorizeView>
    <Authorized>
        <div class="navbar-text ms-auto me-3">
            <span>Welcome, <strong>@context.User.FindFirst(ClaimTypes.Email)?.Value</strong></span>
            @if (context.User.IsInRole("Admin"))
            {
                <span class="badge bg-danger ms-2">Admin</span>
            }
            else
            {
                <span class="badge bg-primary ms-2">Player</span>
            }
            <button class="btn btn-sm btn-outline-light ms-2" @onclick="HandleLogout">
                Logout
            </button>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="navbar-text ms-auto me-3">
            <em>Not authenticated</em>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private async Task HandleLogout()
    {
        // In App Service Easy Auth, logout is handled by redirecting to:
        // /.auth/logout?post_logout_redirect_uri=/
        await Task.CompletedTask;
        NavigationManager.NavigateTo("/.auth/logout", forceLoad: true);
    }
}
