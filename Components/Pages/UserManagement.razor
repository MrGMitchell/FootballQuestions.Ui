@page "/admin/users"
@using FootballQuestions.Ui.Services
@inject IUserIdentityService UserIdentityService
@inject HttpClient HttpClient
@inject NavigationManager NavigationManager
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

<div class="container mt-4">
    <h1>User Management</h1>

    @if (isLoading)
    {
        <p><em>Loading...</em></p>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }
    else
    {
        <div class="row mb-3">
            <div class="col-md-6">
                <h5>Add User Role</h5>
                <div class="form-group mb-2">
                    <label for="userEmail">User Email</label>
                    <input type="email" class="form-control" id="userEmail" @bind="newUserEmail" placeholder="user@example.com" />
                </div>
                <div class="form-group mb-2">
                    <label for="userRole">Role</label>
                    <select class="form-control" id="userRole" @bind="newUserRole">
                        <option value="">Select a role</option>
                        <option value="Admin">Admin</option>
                        <option value="Player">Player</option>
                    </select>
                </div>
                <button class="btn btn-primary" @onclick="AssignRole" disabled="@(string.IsNullOrWhiteSpace(newUserEmail) || string.IsNullOrWhiteSpace(newUserRole))">
                    Assign Role
                </button>
            </div>
        </div>

        <hr />

        <h5>Current Users</h5>
        @if (users.Count == 0)
        {
            <p><em>No users found</em></p>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Email</th>
                        <th>Role</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in users)
                    {
                        <tr>
                            <td>@user.Key</td>
                            <td>
                                <span class="badge @(user.Value == "Admin" ? "bg-danger" : "bg-primary")">
                                    @user.Value
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</div>

@code {
    private Dictionary<string, string> users = new();
    private string newUserEmail = string.Empty;
    private string newUserRole = string.Empty;
    private bool isLoading = true;
    private string? errorMessage = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var response = await HttpClient.GetAsync("api/auth/users");
            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadAsStringAsync();
                users = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(content) ?? new();
            }
            else
            {
                errorMessage = "Failed to load users. You may not have admin access.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading users: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AssignRole()
    {
        if (string.IsNullOrWhiteSpace(newUserEmail) || string.IsNullOrWhiteSpace(newUserRole))
            return;

        try
        {
            var request = new { userEmail = newUserEmail, role = newUserRole };
            var jsonContent = new StringContent(
                System.Text.Json.JsonSerializer.Serialize(request),
                System.Text.Encoding.UTF8,
                "application/json");

            var response = await HttpClient.PostAsync("api/auth/assign-role", jsonContent);

            if (response.IsSuccessStatusCode)
            {
                newUserEmail = string.Empty;
                newUserRole = string.Empty;
                await LoadUsers();
            }
            else
            {
                errorMessage = "Failed to assign role. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error assigning role: {ex.Message}";
        }
    }
}
