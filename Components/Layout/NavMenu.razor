@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="#">
            <img src="/Images/wise-ref-logo.png" alt="Logo" width="30" height="24" class="d-inline-block align-text-top">
            Wise Ref
        </a>
        <UserAuthDisplay />
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Daily Question
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="practice">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Practice
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="dashboard">
                <span class="bi bi-graph-up-nav-menu" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="subscribe">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Subscribe
            </NavLink>
        </div>

        <AuthorizeView Roles="Admin">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/users">
                    <span class="bi bi-people-fill" aria-hidden="true"></span> User Management
                </NavLink>
            </div>
        </AuthorizeView>
    </nav>
</div>

